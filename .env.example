# Browser-safe values only (the Supabase URL and publishable key are public by design).
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Provider secrets do NOT go here. See supabase/functions/.env.example.
# Optional: the published site address used in copied links (e.g. https://your-site.lovable.app),
# so links made from a Lovable preview still open without a Lovable login in OBS.
VITE_PUBLIC_SITE_URL=

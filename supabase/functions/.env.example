# Supabase Edge Function secrets. Set them with:
#   supabase secrets set --env-file supabase/functions/.env
# (copy this file to .env first; never commit the real one)
FINNHUB_API_KEY=your-finnhub-key
LOGO_DEV_PUBLISHABLE_KEY=pk_your-logo-dev-key
# Optional: seconds before the relay hands over to a fresh worker.
# Keep it under the plan's wall-clock limit: 140 for Free (150 s), up to 390 on paid plans (400 s).
RELAY_MAX_SECONDS=140
# Optional: require this code on the setup page before the ticker can be created.
# TICKER_SETUP_CODE=choose-a-long-random-string
